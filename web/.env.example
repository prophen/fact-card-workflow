# Optional custom domain for absolute social preview URLs.
# Vercel's production domain is used automatically when this is unset.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SANITY_PROJECT_ID=ta2gi825
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only Viewer token used to include drafts in the post library
SANITY_API_READ_TOKEN=

# Server-only provider credentials for the Studio generation tool
OPENAI_API_KEY=
EXA_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SANITY_STUDIO_ORIGINS=http://localhost:3333,http://127.0.0.1:3333
